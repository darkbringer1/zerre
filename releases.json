      "sections": [
        {
          "title": "First public release",
          "items": [
            {
              "title": "A pixel creature that lives on your desktop: naps on the Dock, hops onto windows, chases your cursor"
            },
            {
              "title": "Grows from what you actually do: a sprout for the days you show up, traits it wears for your habits"
            },
            {
              "title": "Dozens of pastimes and trait combos, from juggling to fishing off a window's edge"
            },
            {
              "title": "Works alongside Claude Code, Codex, Gemini CLI and OpenCode: holds up a note when an agent needs you"
            },
            {
              "title": "Calm by default: at most three nudges a day, quiet in meetings, focus and at night"
            },
            {
              "title": "Private: notices that things happen, never what they were, and keeps it all on your Mac"
            }
          ]
